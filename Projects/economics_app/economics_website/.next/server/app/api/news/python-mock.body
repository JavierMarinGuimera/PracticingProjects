[{"title":"Los rendimientos de bonos repuntan tras nuevos datos de inflación subyacente","summary":"El mercado ajusta expectativas de tipos después de una lectura de inflación más persistente en servicios.","impact":"Presión al alza en yields, múltiplos de valoración más exigentes para crecimiento y posible fortaleza del dólar.","investmentInsight":"Vigilar rotación hacia bancos, energía y compañías con flujo de caja resistente; la duración larga en bonos queda más sensible a próximos datos.","horizon":"short-term"},{"title":"Fabricantes de semiconductores anticipan mejora gradual de pedidos industriales","summary":"Varios proveedores apuntan a recuperación de demanda en automatización, centros de datos y electrónica avanzada.","impact":"Puede mejorar expectativas de ingresos en chips, hardware de IA e industriales, aunque las valoraciones ya descuentan parte del crecimiento.","investmentInsight":"La oportunidad está en confirmar si la recuperación se amplía fuera de los líderes de IA; revisar márgenes, inventarios y guidance.","horizon":"medium-term"},{"title":"El crudo sube por nuevas restricciones logísticas en rutas clave","summary":"Los precios de energía reaccionan ante interrupciones temporales en transporte y primas de riesgo geopolítico.","impact":"Mayor coste energético para transporte e industria, apoyo a productores y presión sobre expectativas de inflación.","investmentInsight":"Energía integrada y servicios petroleros pueden recibir soporte táctico; aerolíneas y transporte son más vulnerables a costes.","horizon":"short-term"},{"title":"El crédito corporativo europeo mantiene spreads ajustados pese a menor crecimiento","summary":"La demanda de bonos investment grade continúa fuerte, aunque los indicadores adelantados se moderan.","impact":"Señal de apetito por carry, pero con menor margen de seguridad ante sorpresas negativas de crecimiento.","investmentInsight":"Puede favorecer estrategias de crédito de calidad y vencimientos intermedios; conviene evitar emisores con refinanciación próxima.","horizon":"medium-term"}]